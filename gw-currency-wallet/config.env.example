# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wallet
DB_SSL_MODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s

# Exchanger gRPC
EXCHANGER_ADDR=localhost:50051
EXCHANGER_TIMEOUT=2s

# JWT
JWT_SECRET=dev-secret-at-least-32-characters-long-please
JWT_TTL=24h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_RATES_TTL=60s

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=large_transfers

# Server
SHUTDOWN_TIMEOUT=10s

# Log
LOG_LEVEL=debug
LOG_FORMAT=text